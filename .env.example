# Backend
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://vendorflow:vendorflow@localhost:5432/vendorflow
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_DIR=private_uploads
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# Optional absolute path when tesseract.exe is not on PATH.
TESSERACT_CMD=
TESSERACT_DATA_DIR=
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT_SECONDS=30
EXTRACTION_MAX_PDF_PAGES=20

# Tests use an isolated PostgreSQL database.
TEST_DATABASE_URL=postgresql+psycopg://vendorflow:vendorflow@localhost:5432/vendorflow_test

# Frontend (copy this value to frontend/.env when overriding the default)
VITE_API_BASE_URL=http://localhost:8000/api/v1

